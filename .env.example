# 大模型 API（OpenAI 兼容，默认 DeepSeek；写进 apps/web/.env.local，不要提交）
LLM_API_KEY=
# 以下三项可不填，默认值如下
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-flash
# LLM_VISION_MODEL=deepseek-flash

# 基础设施
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql://user:pass@localhost:5432/irenovation

# 阿里云 OSS
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# 登录（apps/web/.env.local）：会话签名密钥（至少 32 个字符）与老板账号
SESSION_SECRET=
BOSS_PHONE=
BOSS_PASSWORD=

# 本站公网地址（会员支付返回），并行站点使用不同且固定的支付前缀；空前缀兼容旧会员。
# PUBLIC_BASE_URL=https://example.com:8443
# MEMBERSHIP_PAYMENT_NAMESPACE=yushe-dual
# 一人付新版独立项目密钥，仅服务器配置，不能使用 NEXT_PUBLIC_ 前缀。
opcpay_api_key=

# Agnes 图像生成
AGNES_API_KEY=

# 合同模式：不设置 = 真实合同（需要接入电子签署与资金服务商，本仓库尚未接入，真实合同无法完成签署）。
# 仅本地演示或验收时设为 demo，使用演示签署与模拟资金；生产环境不要设置。详见 docs/V2使用与部署说明.md
# CONTRACT_MODE=demo
